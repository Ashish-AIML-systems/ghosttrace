# Copy to `.env` (git-ignored) to override defaults. Everything below already has
# a working default, so a missing .env is fine for local development.

POSTGRES_USER=audit
POSTGRES_PASSWORD=audit
POSTGRES_DB=audit

# Host ports (container ports stay 5432 / 8000). Change if something local uses them.
DB_PORT=5432
API_PORT=8000

# Where the .gguf model files live on YOUR machine (default: ./models)
# MODELS_DIR=D:/llm-models
# MODELS_DIR=/Users/me/llm-models
